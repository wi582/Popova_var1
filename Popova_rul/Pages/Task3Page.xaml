<Page x:Class="Popova_rul.Pages.Task3Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Popova_rul.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Task3Page">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="14"
                   Margin="0,0,0,15"
                   Text="Задача 3. Найти в массиве все числа, составленные из одних и тех же цифр."/>

        <TextBlock Grid.Row="1" Text="Введите числа через пробел:"
                   Margin="0,0,0,5"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBox x:Name="txtInput" Width="400" Height="30" FontSize="14"/>
            <Button x:Name="btnCheck" Content="Найти"
                    Width="120" Height="30" Margin="10,0,0,0"
                    Click="btnCheck_Click"/>
        </StackPanel>

        <TextBox x:Name="txtResult" Grid.Row="3"
                 IsReadOnly="True" TextWrapping="Wrap"
                 FontSize="14" Background="LightGray"
                 VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Page>