<Page x:Class="Popova_rul.Pages.MenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Popova_rul.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MenuPage">

    <Grid>
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="250">

            <TextBlock Text="Вариант №1"
                       FontSize="36" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <Button x:Name="btnTask1" Content="Задача 1"
                    Height="50" FontSize="18"
                    Margin="0,0,0,10"
                    HorizontalAlignment="Stretch"
                    Click="btnTask1_Click"/>

            <Button x:Name="btnTask2" Content="Задача 2"
                    Height="50" FontSize="18"
                    Margin="0,0,0,10"
                    HorizontalAlignment="Stretch"
                    Click="btnTask2_Click"/>

            <Button x:Name="btnTask3" Content="Задача 3"
                    Height="50" FontSize="18"
                    Margin="0,0,0,10"
                    HorizontalAlignment="Stretch"
                    Click="btnTask3_Click"/>

            <Button x:Name="btnTask4" Content="Задача 4"
                    Height="50" FontSize="18"
                    Margin="0,0,0,10"
                    HorizontalAlignment="Stretch"
                    Click="btnTask4_Click"/>

            <Button x:Name="btnTask5" Content="Задача 5"
                    Height="50" FontSize="18"
                    HorizontalAlignment="Stretch"
                    Click="btnTask5_Click"/>

        </StackPanel>
    </Grid>
</Page>