<Page x:Class="Popova_rul.Pages.Task4Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Popova_rul.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Task4Page">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="14"
                   Margin="0,0,0,15"
                   Text="Задача 4. Дан массив x[1..m+n]. Переставить начало (m элементов) и конец (n элементов) местами без дополнительного массива."/>

        <TextBlock Grid.Row="1" Text="Введите массив через пробел:"
                   Margin="0,0,0,5"/>
        <!-- УБРАЛИ Text="1 2 3 4 5 6 7 8" -->
        <TextBox x:Name="txtArray" Height="30" FontSize="14"
                 Margin="0,0,0,10"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="m = " VerticalAlignment="Center"/>
            <!-- УБРАЛИ Text="3" -->
            <TextBox x:Name="txtM" Width="60" Height="25"
                     Margin="5,0,20,0" VerticalAlignment="Center"/>
            <TextBlock Text="n = " VerticalAlignment="Center"/>
            <!-- УБРАЛИ Text="5" -->
            <TextBox x:Name="txtN" Width="60" Height="25"
                     Margin="5,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Button x:Name="btnCheck" Grid.Row="3"
                Content="Переставить" Width="150" Height="35"
                HorizontalAlignment="Left" Margin="0,0,0,15"
                Click="btnCheck_Click"/>

        <TextBox x:Name="txtResult" Grid.Row="4"
                 IsReadOnly="True" TextWrapping="Wrap"
                 FontSize="14" Background="LightGray"
                 VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Page>
