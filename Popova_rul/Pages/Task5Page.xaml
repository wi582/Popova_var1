<Page x:Class="Popova_rul.Pages.Task5Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Popova_rul.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Task5Page">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="14"
                   Margin="0,0,0,10"
                   Text="Задача 5. Сгенерировать матрицу N×M (числа от -10 до 10), отсортировать по возрастанию и убыванию, найти мин и макс."/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="N (строк) = " VerticalAlignment="Center"/>
            <!-- УБРАЛИ Text="3" -->
            <TextBox x:Name="txtN" Width="50" Height="25"
                     Margin="5,0,20,0" VerticalAlignment="Center"/>
            <TextBlock Text="M (столбцов) = " VerticalAlignment="Center"/>
            <!-- УБРАЛИ Text="4" -->
            <TextBox x:Name="txtM" Width="50" Height="25"
                     Margin="5,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Button x:Name="btnGenerate" Grid.Row="2"
                Content="Сгенерировать и отсортировать"
                Width="250" Height="35"
                HorizontalAlignment="Left" Margin="0,0,0,15"
                Click="btnGenerate_Click"/>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Исходная матрица:" FontWeight="Bold"/>
                <TextBox x:Name="txtOriginal" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="14"
                         Background="LightGray" Margin="0,0,0,10"
                         AcceptsReturn="True" TextWrapping="NoWrap"/>

                <TextBlock Text="По возрастанию:" FontWeight="Bold"/>
                <TextBox x:Name="txtAsc" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="14"
                         Background="LightBlue" Margin="0,0,0,10"
                         AcceptsReturn="True" TextWrapping="NoWrap"/>

                <TextBlock Text="По убыванию:" FontWeight="Bold"/>
                <TextBox x:Name="txtDesc" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="14"
                         Background="LightYellow" Margin="0,0,0,10"
                         AcceptsReturn="True" TextWrapping="NoWrap"/>

                <TextBlock x:Name="txtMinMax" FontWeight="Bold" FontSize="14"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>