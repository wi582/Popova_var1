<Page x:Class="Popova_rul.Pages.Task1Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Popova_rul.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Task1Page">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="14"
                   Margin="0,0,0,20"
                   Text="Задача 1. Число вводится своим двоичным представлением (до 10000 разрядов). Определить, делится ли оно на 15."/>

        <TextBlock Grid.Row="1" Text="Введите двоичное число:"
                   Margin="0,0,0,5"/>

        <TextBox x:Name="txtInput" Grid.Row="2"
                 Height="30" FontSize="14"
                 Margin="0,0,0,15"/>

        <Button x:Name="btnCheck" Grid.Row="3"
                Content="Проверить"
                Width="150" Height="35"
                HorizontalAlignment="Left"
                Margin="0,0,0,15"
                Click="btnCheck_Click"/>

        <StackPanel Grid.Row="4">
            <TextBlock Text="Результат:" Margin="0,0,0,5"/>
            <TextBox x:Name="txtResult"
                     Height="60" FontSize="14"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     Background="LightGray"/>
        </StackPanel>
    </Grid>
</Page>